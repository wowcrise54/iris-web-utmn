PUBLIC_EXTERNAL_API_URL=http://localhost:8080
PUBLIC_INTERNAL_API_URL=http://localhost:8080
PUBLIC_PLAUSIBLE_DOMAIN=

# Trusted browser tunnel destination; must match the frontend DSN in backend runtime-config.
# Empty disables /monitoring/envelope (503). HTTPS is required.
IRIS_UI_SENTRY_DSN=
# Opt in only for a configured private-network ingest deployment.
IRIS_UI_ENVELOPE_ALLOW_PRIVATE=0
# Prefer a trusted private CA; this existing escape hatch disables TLS verification.
IRIS_UI_ENVELOPE_INSECURE_TLS=0
